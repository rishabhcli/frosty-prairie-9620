# Local CockroachDB (docker-compose, port block 14900-14999)
DATABASE_URL=postgresql://root@127.0.0.1:14910/contactsafe?sslmode=disable

# Bedrock: leave unset / "fixture" to run in deterministic fixture mode.
# Set to "live" and provide AWS credentials via the standard AWS SDK credential
# chain (env vars, profile, or role) to call the real Converse API.
BEDROCK_MODE=fixture
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# CockroachDB Managed MCP: leave unset to run the local fixture-contract bridge
# (same tool contract, backed by the local DB). Set both to point at a real
# CockroachDB Cloud Managed MCP endpoint.
COCKROACH_MANAGED_MCP_ENDPOINT=
COCKROACH_MANAGED_MCP_API_KEY=

# Port block 14900-14999 (repository slug: frosty-prairie-9620)
PORT_CONSOLE=14900
PORT_API=14901
PORT_AGENT_WORKER=14902
PORT_OUTBOX_WORKER=14903
