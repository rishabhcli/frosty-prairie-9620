{
  "name": "contactsafe",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r --workspace-concurrency=1 run test:integration",
    "test:e2e": "pnpm --filter @contactsafe/console build && playwright test",
    "eval:race": "tsx eval/race/run.ts",
    "eval:faults": "tsx eval/faults/run.ts",
    "eval:memory": "tsx eval/memory/run.ts",
    "build": "pnpm -r run build",
    "build:lambda": "pnpm build && node infra/aws/build-lambda.mjs",
    "package:lambda": "pnpm build:lambda && rm -f infra/aws/contactsafe-lambda.zip && cd infra/aws/dist && zip -qr ../contactsafe-lambda.zip .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "tsx packages/db/src/migrate.run.ts",
    "db:seed": "tsx packages/db/src/seed.run.ts",
    "db:reset": "tsx packages/db/src/reset.run.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.12.0",
    "@playwright/test": "^1.49.0",
    "@axe-core/playwright": "^4.10.1",
    "esbuild": "^0.28.1"
  }
}
