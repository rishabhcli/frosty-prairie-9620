{
  "name": "@contactsafe/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.888.0",
    "@contactsafe/contracts": "workspace:*",
    "@contactsafe/db": "workspace:*",
    "@contactsafe/agent-worker": "workspace:*",
    "@contactsafe/outbox-worker": "workspace:*",
    "@contactsafe/bedrock": "workspace:*",
    "pg": "^8.13.1",
    "fastify": "^5.1.0",
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
